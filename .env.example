# Plesk: add these as separate Custom Environment Variables. Never commit real passwords.
NODE_ENV=production
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tonpra_reunion_v1
DB_USER=tonpra_reunion_app
DB_PASSWORD=CHANGE_THIS_TO_THE_DATABASE_PASSWORD
DATABASE_CONNECTION_LIMIT=5
APP_ORIGIN=https://90reunion.tonpradoo.com
# Sibling of Application Root; outside public/ and preserved between releases.
STORAGE_DIR=../90reunion-storage
# Your own >=12-character password, used ONCE by db:setup for six demo accounts.
DEMO_PASSWORD=CHANGE_THIS_BEFORE_SEEDING

# Alternative for an existing PostgreSQL/local setup (do not enable both styles):
# DATABASE_URL=postgresql://APP_USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/APP_DATABASE
# MariaDB URL is also supported: mariadb://APP_USER:URL_ENCODED_PASSWORD@127.0.0.1:3306/APP_DATABASE
