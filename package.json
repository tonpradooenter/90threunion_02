{
  "name": "sisat-90-reunion-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:setup": "node --env-file-if-exists=.env.local --import tsx scripts/db-setup.ts",
    "db:check": "node --env-file-if-exists=.env.local --import tsx scripts/db-check.ts",
    "db:backfill": "node --env-file-if-exists=.env.local --import tsx scripts/db-backfill.ts",
    "db:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/db-smoke.ts",
    "test:integration": "node --env-file-if-exists=.env.mariadb.local --import tsx --test tests/mariadb.integration.ts",
    "dev:mariadb": "node --env-file=.env.mariadb.local node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "db:setup:mariadb": "node --env-file=.env.mariadb.local --import tsx scripts/db-setup.ts",
    "db:check:mariadb": "node --env-file=.env.mariadb.local --import tsx scripts/db-check.ts",
    "start:plesk": "node app.cjs",
    "release:zip": "node scripts/package-release.mjs",
    "test:api": "node --env-file-if-exists=.env.mariadb.local scripts/verify-http.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.2.8",
    "@fontsource/outfit": "^5.2.7",
    "exceljs": "^4.4.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "mariadb": "^3.5.4",
    "next": "^16.0.0",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
